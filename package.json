    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.1.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "eslint-config-prettier": "^9.1.0"
  },
  "packageManager": "pnpm@8.15.4",
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
