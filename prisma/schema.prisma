generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CITIZEN
  FIELD_WORKER
  OFFICER
  DISTRICT_ADMIN
  ANALYST
  AUDITOR
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ReportSourceChannel {
  MOBILE
  WEB
  WHATSAPP
  IVR
  KIOSK
}

enum ReportStatus {
  CREATED
  PROCESSING
  AWAITING_CONFIRMATION
  SUBMITTED
  AI_PROCESSED
  CLUSTERED
  PRIORITIZED
  UNDER_REVIEW
  NEEDS_MORE_INFO
  ACTION_PLANNED
  IN_PROGRESS
  RESOLVED
  REJECTED
  DUPLICATE
}

enum IssueCategory {
  WATER
  ROADS
  HEALTH
  EDUCATION
  SANITATION
  ELECTRICITY
  TRANSPORT
  PUBLIC_SAFETY
  HOUSING
  OTHER
}

enum LocationSource {
  USER_CONFIRMED
  WHATSAPP_SHARED
  MAP_SELECTED
  VERIFIED_ADDRESS
  ADMINISTRATIVE_MAPPING
  OFFICER_CORRECTED
  AI_EXTRACTED_MENTION
}

model District {
  id        String   @id @default(uuid()) @db.Char(36)
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wards    Ward[]
  citizens CitizenProfile[]
  officers OfficerProfile[]
  reports  Report[]

  @@map("districts")
}

model Ward {
  id         String   @id @default(uuid()) @db.Char(36)
  districtId String   @map("district_id") @db.Char(36)
  code       String   @db.VarChar(32)
  name       String   @db.VarChar(160)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  district  District   @relation(fields: [districtId], references: [id], onDelete: Restrict)
  locations Location[]

  @@unique([districtId, code])
  @@map("wards")
}

model User {
  id          String     @id @default(uuid()) @db.Char(36)
  firebaseUid String     @unique @map("firebase_uid") @db.VarChar(191)
  role        UserRole
  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?  @map("last_login_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  citizen      CitizenProfile?
  officer      OfficerProfile?
  reports      Report[]
  auditEntries AuditLog[]

  @@map("users")
}

model CitizenProfile {
  id                String   @id @default(uuid()) @db.Char(36)
  userId            String   @unique @map("user_id") @db.Char(36)
  districtId        String?  @map("district_id") @db.Char(36)
  displayName       String?  @map("display_name") @db.VarChar(160)
  phoneHash         String?  @map("phone_hash") @db.Char(64)
  phoneLast4        String?  @map("phone_last4") @db.Char(4)
  preferredLanguage String?  @map("preferred_language") @db.VarChar(10)
  consentVersion    String?  @map("consent_version") @db.VarChar(32)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  district District? @relation(fields: [districtId], references: [id], onDelete: Restrict)
  reports  Report[]

  @@index([districtId])
  @@map("citizens")
}

model OfficerProfile {
  id                String   @id @default(uuid()) @db.Char(36)
  userId            String   @unique @map("user_id") @db.Char(36)
  districtId        String   @map("district_id") @db.Char(36)
  employeeReference String   @unique @map("employee_reference") @db.VarChar(100)
  department        String?  @db.VarChar(160)
  mfaRequired       Boolean  @default(true) @map("mfa_required")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  district District @relation(fields: [districtId], references: [id], onDelete: Restrict)

  @@index([districtId])
  @@map("officers")
}

model Location {
  id         String         @id @default(uuid()) @db.Char(36)
  districtId String         @map("district_id") @db.Char(36)
  wardId     String?        @map("ward_id") @db.Char(36)
  latitude   Decimal?       @db.Decimal(10, 7)
  longitude  Decimal?       @db.Decimal(10, 7)
  source     LocationSource
  confidence Decimal?       @db.Decimal(5, 4)
  createdAt  DateTime       @default(now()) @map("created_at")

  district District @relation(fields: [districtId], references: [id], onDelete: Restrict)
  ward     Ward?    @relation(fields: [wardId], references: [id], onDelete: Restrict)
  reports  Report[]

  @@index([districtId])
  @@index([wardId])
  @@map("locations")
}

model Report {
  id            String              @id @default(uuid()) @db.Char(36)
  publicId      String              @unique @map("public_id") @db.VarChar(40)
  citizenId     String              @map("citizen_id") @db.Char(36)
  districtId    String              @map("district_id") @db.Char(36)
  locationId    String?             @map("location_id") @db.Char(36)
  sourceChannel ReportSourceChannel @map("source_channel")
  status        ReportStatus        @default(CREATED)
  language      String              @db.VarChar(10)
  category      IssueCategory
  subcategory   String              @db.VarChar(100)
  summary       String              @db.VarChar(500)
  description   String              @db.Text
  severity      Int
  urgency       Int
  submittedAt   DateTime?           @map("submitted_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  citizen  CitizenProfile @relation(fields: [citizenId], references: [id], onDelete: Restrict)
  district District       @relation(fields: [districtId], references: [id], onDelete: Restrict)
  location Location?      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  events   ReportEvent[]

  @@index([citizenId])
  @@index([districtId])
  @@index([locationId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("reports")
}

model ReportEvent {
  id        String       @id @default(uuid()) @db.Char(36)
  reportId  String       @map("report_id") @db.Char(36)
  fromStatus ReportStatus? @map("from_status")
  toStatus  ReportStatus @map("to_status")
  actorId   String?      @map("actor_id") @db.Char(36)
  reason    String?      @db.VarChar(1000)
  requestId String?      @map("request_id") @db.VarChar(100)
  createdAt DateTime     @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@map("report_events")
}

model ScoringConfiguration {
  id        String   @id @default(uuid()) @db.Char(36)
  version   Int      @unique
  weights   Json
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scoring_configurations")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Char(36)
  actorUserId  String?  @map("actor_user_id") @db.Char(36)
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(100)
  resourceId   String   @map("resource_id") @db.VarChar(100)
  districtId   String?  @map("district_id") @db.Char(36)
  metadata     Json?    @map("metadata_json")
  requestId    String   @map("request_id") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId])
  @@index([resourceId])
  @@map("audit_logs")
}

model IdempotencyKey {
  id          String   @id @default(uuid()) @db.Char(36)
  key         String   @unique @db.VarChar(191)
  actorUserId String?  @map("actor_user_id") @db.Char(36)
  route       String   @db.VarChar(191)
  response    Json?    @map("response_json")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

