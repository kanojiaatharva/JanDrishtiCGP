generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Identity & Access
// -----------------------------------------------------------------------------

model User {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  phone    String? @unique
  email    String? @unique
  password String?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  refreshTokens RefreshToken[]
  consents      Consent[]
  auditLogs     AuditLog[]

  citizenProfile CitizenProfile?
  officerProfile OfficerProfile?
  notifications  Notification[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @db.VarChar(512)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model Consent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  accepted  Boolean
  ipAddress String?
  timestamp DateTime @default(now())
}

// -----------------------------------------------------------------------------
// Profiles
// -----------------------------------------------------------------------------

model CitizenProfile {
  id                 String  @id @default(uuid())
  userId             String  @unique
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName          String?
  lastName           String?
  languagePreference String  @default("hi")

  reports        CitizenReport[]
  whatsappConvos WhatsAppConversation[]
}

model OfficerProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  designation String
  districtId  String?
  district    District? @relation(fields: [districtId], references: [id])

  statusHistory ReportStatusHistory[]
  decisions     OfficerDecision[]
}

// -----------------------------------------------------------------------------
// Geography
// -----------------------------------------------------------------------------

model State {
  id        String     @id @default(uuid())
  name      String     @unique
  code      String     @unique
  districts District[]
}

model District {
  id      String @id @default(uuid())
  name    String
  stateId String
  state   State  @relation(fields: [stateId], references: [id], onDelete: Cascade)
  wards   Ward[]

  officers OfficerProfile[]
  plans    InvestmentPlan[]

  @@unique([name, stateId])
}

model Ward {
  id         String   @id @default(uuid())
  name       String
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  locations      Location[]
  infrastructure InfrastructureIndicator[]
  demographics   DemographicIndicator[]

  @@unique([name, districtId])
}

model Location {
  id      String  @id @default(uuid())
  lat     Float?
  lng     Float?
  address String?
  wardId  String?
  ward    Ward?   @relation(fields: [wardId], references: [id], onDelete: SetNull)

  reports CitizenReport[]
}

// -----------------------------------------------------------------------------
// Civic Data
// -----------------------------------------------------------------------------

model IssueCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  reports CitizenReport[]
}

enum ReportStatus {
  CREATED
  PROCESSING
  AWAITING_CONFIRMATION
  SUBMITTED
  CLUSTERED
  PRIORITIZED
  UNDER_REVIEW
  ACTION_PLANNED
  IN_PROGRESS
  RESOLVED
  NEEDS_MORE_INFO
  DUPLICATE
  REJECTED
}

enum ReportChannel {
  WEB
  MOBILE
  VOICE
  WHATSAPP
  KIOSK
}

model CitizenReport {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  citizenId String
  citizen   CitizenProfile @relation(fields: [citizenId], references: [id])

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  categoryId String?
  category   IssueCategory? @relation(fields: [categoryId], references: [id])

  status  ReportStatus  @default(CREATED)
  channel ReportChannel @default(MOBILE)

  originalInput  String  @db.Text
  language       String  @default("hi")
  transcription  String? @db.Text
  normalizedText String? @db.Text

  urgency  Int?
  severity Int?

  clusterId String?
  cluster   DemandCluster? @relation(fields: [clusterId], references: [id])

  attachments   ReportAttachment[]
  statusHistory ReportStatusHistory[]
  aiAnalysis    AIAnalysis?
}

model ReportAttachment {
  id        String        @id @default(uuid())
  reportId  String
  report    CitizenReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  url       String
  type      String
  createdAt DateTime      @default(now())
}

model ReportStatusHistory {
  id          String          @id @default(uuid())
  reportId    String
  report      CitizenReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status      ReportStatus
  changedById String?
  changedBy   OfficerProfile? @relation(fields: [changedById], references: [id], onDelete: SetNull)
  reason      String?         @db.Text
  timestamp   DateTime        @default(now())
}

// -----------------------------------------------------------------------------
// AI Processing
// -----------------------------------------------------------------------------

model AIAnalysis {
  id       String        @id @default(uuid())
  reportId String        @unique
  report   CitizenReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  provider          String
  modelVersion      String
  promptVersion     String
  confidence        Float
  extractedEntities Json?
  structuredOutput  Json?
  processingTimeMs  Int?
  failureState      String? @db.Text

  createdAt DateTime @default(now())
}

model DemandCluster {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("ACTIVE")
  centerLat Float?
  centerLng Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports CitizenReport[]
  hotspot DemandHotspot?
}

model DemandHotspot {
  id            String        @id @default(uuid())
  clusterId     String        @unique
  cluster       DemandCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  severityScore Float?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  priorityScore  PriorityScore?
  evidence       Evidence[]
  recommendation Recommendation?
}

// -----------------------------------------------------------------------------
// Evidence & Context
// -----------------------------------------------------------------------------

model Evidence {
  id        String        @id @default(uuid())
  hotspotId String
  hotspot   DemandHotspot @relation(fields: [hotspotId], references: [id], onDelete: Cascade)
  type      String
  source    String
  data      Json
  createdAt DateTime      @default(now())
}

model InfrastructureIndicator {
  id         String   @id @default(uuid())
  wardId     String
  ward       Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)
  metricName String
  value      Float
  updatedAt  DateTime @updatedAt

  @@unique([wardId, metricName])
}

model DemographicIndicator {
  id           String   @id @default(uuid())
  wardId       String   @unique
  ward         Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)
  population   Int
  demographics Json
  updatedAt    DateTime @updatedAt
}

model InvestmentPlan {
  id         String    @id @default(uuid())
  districtId String?
  district   District? @relation(fields: [districtId], references: [id], onDelete: Cascade)
  title      String
  budget     Float
  status     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// -----------------------------------------------------------------------------
// Prioritization & Action
// -----------------------------------------------------------------------------

model PriorityScore {
  id        String        @id @default(uuid())
  hotspotId String        @unique
  hotspot   DemandHotspot @relation(fields: [hotspotId], references: [id], onDelete: Cascade)

  finalScore              Float
  demandComponent         Float
  severityComponent       Float
  needGapComponent        Float
  infrastructureComponent Float
  populationComponent     Float
  planGapComponent        Float

  createdAt DateTime @default(now())
}

model Recommendation {
  id          String        @id @default(uuid())
  hotspotId   String        @unique
  hotspot     DemandHotspot @relation(fields: [hotspotId], references: [id], onDelete: Cascade)
  title       String
  description String        @db.Text
  aiGenerated Boolean       @default(true)
  status      String        @default("PENDING")

  decisions OfficerDecision[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model OfficerDecision {
  id               String         @id @default(uuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  officerId        String
  officer          OfficerProfile @relation(fields: [officerId], references: [id])
  decision         String
  rationale        String         @db.Text
  timestamp        DateTime       @default(now())
}

// -----------------------------------------------------------------------------
// Communication & Audit
// -----------------------------------------------------------------------------

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model WhatsAppConversation {
  id          String         @id @default(uuid())
  citizenId   String
  citizen     CitizenProfile @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  phoneNumber String
  status      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages WhatsAppMessage[]

  @@index([phoneNumber])
}

model WhatsAppMessage {
  id             String               @id @default(uuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String               @unique
  content        String               @db.Text
  direction      String
  createdAt      DateTime             @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  metadata  Json?
  timestamp DateTime @default(now())

  @@index([userId, action])
}
